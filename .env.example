# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.
#
# Deploying to the cloud? A few of these need DIFFERENT values there
# than for local dev (HEADLESS, AUTO_SOLVE_CAPTCHA, DATABASE_URL,
# WEB_SECRET_KEY) — see docs/DEPLOYMENT.md for the full production
# variable table, not just this local-dev-oriented file.

# --- Target application ---
TARGET_BASE_URL=https://www.jwintell.com
TARGET_LOGIN_URL=https://www.jwintell.com/NgsEmfuaOv.php/index/login?url=%2FNgsEmfuaOv.php%2Fdashboard%3Flang%3Den-us%26ref%3Daddtabs
TARGET_USERNAME=
TARGET_PASSWORD=

# --- Browser / session ---
# Path where the authenticated browser storage state (cookies + localStorage) is persisted
# so the app does not have to log in (and solve a CAPTCHA) on every run.
STORAGE_STATE_PATH=data/storage_state/session.json
# true = visible browser window (required the first time, to solve the CAPTCHA manually).
# Once a valid storage state exists, HEADLESS=true can reuse the session without a visible window.
HEADLESS=false
# How long (seconds) to wait for a human to complete login/CAPTCHA in the
# visible browser window before authenticate() gives up. Ignored if
# AUTO_SOLVE_CAPTCHA=true.
AUTH_MANUAL_TIMEOUT_SECONDS=300
# DEFAULT OFF — leave false unless you have explicit authorization to
# automate past this target's CAPTCHA on your own account. The original
# spec for this project explicitly forbids bypassing CAPTCHA; this flag
# only exists because the account owner confirmed (2026-08-23) that this
# specific target's captcha endpoint doesn't validate the submitted code
# and explicitly authorized automating past it. Do not enable this
# against a different target without the same kind of explicit,
# case-by-case authorization. See target_client.py's authenticate().
AUTO_SOLVE_CAPTCHA=false

# --- Polling (Phase 2 POC) ---
POLL_INTERVAL_SECONDS=60
POC_ITERATIONS=3

# --- Database (Phase 3) ---
# Used by both docker-compose.yml (to configure the Postgres container) and
# db/base.py (to connect to it). Defaults match docker-compose.yml's
# fallback values, so `docker compose up -d` + these defaults work
# out of the box for local dev.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=equipment_monitor
DB_USER=equipment_monitor
DB_PASSWORD=equipment_monitor
# Optional: overrides DB_* entirely if set — e.g. DATABASE_URL=sqlite:///./dev.db
# for a quick local run without Docker/Postgres.
DATABASE_URL=

# --- Alerting / email (Phase 4) ---
# Leave SMTP_HOST empty to use the console fallback channel (logs the
# email instead of sending it) — useful for local dev without real SMTP
# credentials. Set all SMTP_* values to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ALERT_ON_ESCALATION=true
SEND_RECOVERY_NOTIFICATIONS=true

# --- Web dashboard (Phase 5) ---
# Signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=

# --- PayU reconciliation (backend/api/reconciliation.py) ---
# From your PayU dashboard: https://payu.in/business/transactions ->
# account/API settings. Leave both blank to disable the feature (the
# /reconciliation page will say so rather than fail confusingly).
# PAYU_ENV=test uses PayU's sandbox base URL instead of production --
# leave as "production" for real transaction data.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=production
